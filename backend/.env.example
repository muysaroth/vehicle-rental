APP_NAME="Vehicle Sales & Rental MIS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE defaults to database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Comma separated origins allowed to call the API. Empty is right for dev
# (Vite proxies /api) and for production (Laravel serves the built app).
CORS_ALLOWED_ORIGINS=

# Login token lifetime in minutes (7 days).
SANCTUM_EXPIRATION=10080

# Optional: pin the demo data's "today" (YYYY-MM-DD) so seeding reproduces the
# figures in docs/03-decision-support.md exactly. Leave empty to use the real date.
DEMO_TODAY=
