# Production settings. Copy to .env on the server, fill in every "CHANGE ME",
# then follow docs/06-deployment.md.

APP_NAME="Vehicle Sales & Rental MIS"
APP_ENV=production
APP_KEY=
# Never true in production: it shows code, paths and settings to visitors.
APP_DEBUG=false
# Your real address, with https://
APP_URL=https://rental.example.com
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database ---------------------------------------------------------------
# One shop: SQLite is enough (the file is backend/database/database.sqlite).
DB_CONNECTION=sqlite

# Several branches / many users at once: use MySQL or MariaDB instead.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vehicle_rental
# DB_USERNAME=rental            # CHANGE ME: a dedicated user, not root
# DB_PASSWORD=                  # CHANGE ME: a long random password

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Empty: the API is only called by the app itself (same address).
CORS_ALLOWED_ORIGINS=

# Login token lifetime in minutes (default 7 days). Shorter is safer on shared computers.
SANCTUM_EXPIRATION=720

# Behind Nginx on the same machine: 127.0.0.1. Behind Cloudflare or a load balancer: its IPs, or *.
TRUSTED_PROXIES=127.0.0.1

# Leave empty in production.
DEMO_TODAY=

# --- First administrator (created by: php artisan db:seed --force) ----------
ADMIN_NAME="Owner"
ADMIN_EMAIL=owner@example.com          # CHANGE ME

# --- Printed on invoices and rental contracts -------------------------------
COMPANY_NAME="Mekong Wheels"           # CHANGE ME
COMPANY_ADDRESS="Phnom Penh, Cambodia"
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_TAX_ID=

# --- Backups (php artisan backup:run, scheduled daily) ----------------------
# Ideally a folder on another disk, or one synced off the server.
BACKUP_PATH=
BACKUP_KEEP=30
BACKUP_AT=01:30
# MySQL only, if mysqldump is not on the PATH, e.g. C:/xampp/mysql/bin/mysqldump.exe
BACKUP_MYSQLDUMP=mysqldump
